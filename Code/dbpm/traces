<?php
// Simple PHP proxy to forward requests to Node.js backend
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization');
header('Content-Type: application/json');

// Handle OPTIONS preflight
if (isset($_SERVER['REQUEST_METHOD']) && $_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit;
}

// Get the request path
$requestUri = isset($_SERVER['REQUEST_URI']) ? $_SERVER['REQUEST_URI'] : '';

// Extract path after /backend
if (preg_match('#/~ga94hor/dbpm/backend(/.*)?$#', $requestUri, $matches)) {
    $path = isset($matches[1]) ? $matches[1] : '/';
} else {
    $path = '/';
}

// Remove index.php if present
$path = str_replace('/index.php', '', $path);

// Remove query string
$path = strtok($path, '?');

// Default to projects list for testing
if (empty($path) || $path === '/') {
    $path = '/projects';
}

// Build the target URL
$nodeUrl = 'http://localhost:8080' . $path;
if (!empty($_SERVER['QUERY_STRING'])) {
    $nodeUrl .= '?' . $_SERVER['QUERY_STRING'];
}

// Prepare request
$method = isset($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : 'GET';
$context_options = [
    'http' => [
        'method' => $method,
        'header' => 'Content-Type: application/json',
        'ignore_errors' => true
    ]
];

// Add body for POST/PUT/DELETE
if (in_array($method, ['POST', 'PUT', 'DELETE'])) {
    $body = file_get_contents('php://input');
    $context_options['http']['content'] = $body;
}

$context = stream_context_create($context_options);

// Make request
$response = @file_get_contents($nodeUrl, false, $context);

// Handle errors
if ($response === false) {
    http_response_code(500);
    echo json_encode(['error' => 'Failed to connect to backend server', 'url' => $nodeUrl]);
    exit;
}

// Output response
echo $response;
